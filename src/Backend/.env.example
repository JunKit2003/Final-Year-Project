# For running the API outside Docker (npm run dev). Copy to src/Backend/.env. Never commit .env.
DATABASE=faction
DATABASE_USERNAME=faction
DATABASE_PASSWORD=change-me
HOST_DATABASE=127.0.0.1
DATABASE_PORT=3306

HOST=http://localhost
PORT_SERVER=8000
# Where Stripe sends shoppers back (the Vite dev server).
PUBLIC_URL=http://localhost:3000
# "" = relative image URLs, served via the Vite dev proxy.
ASSET_BASE_URL=

SESSION_SECRET=change-me
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=
STRIPE_SECRET_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
