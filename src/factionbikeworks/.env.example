# Copy to .env.local for `npm run dev`. All optional.

# API origin. Leave empty: the dev server proxies /api and /images (see vite.config.js),
# and in the container nginx does the same, so the browser always talks to one origin.
VITE_API_URL=

# Where the dev proxy sends /api and /images (the backend from `npm run dev` in src/Backend).
DEV_BACKEND_URL=http://localhost:8000
