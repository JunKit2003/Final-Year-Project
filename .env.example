# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# --- Database (MySQL container) ---
DB_NAME=faction
DB_USER=faction
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- API ---
# Long random string: openssl rand -hex 32. Changing it signs everyone out.
SESSION_SECRET=change-me
# First admin account on an empty database. Leave the password empty to have a random one
# generated and printed once in the backend logs (docker compose logs backend).
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=
# Public origin of the site. Stripe redirects back here after checkout.
PUBLIC_URL=http://localhost:8080
# true when the site is served over HTTPS (Secure session cookie).
COOKIE_SECURE=false
# Optional: comma-separated origins allowed to make credentialed cross-origin API calls.
# Leave empty for the default same-origin setup.
CORS_ORIGINS=

# --- Stripe (test keys work: sk_test_...) ---
STRIPE_SECRET_KEY=

# --- Email for password reset codes (e.g. Brevo SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=

# --- Where the site is published on the host ---
# 127.0.0.1 keeps it local (put a reverse proxy in front); 0.0.0.0 exposes it directly.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
